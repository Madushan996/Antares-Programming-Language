# A Little World
# A 3D village to roll a ball around: sunlight and soft shadows, shiny and
# metal things, glass, fog, and lamps that light up at night.
# Arrow keys or W A S D roll the ball; N switches day and night; F fills
# the screen; Escape leaves.
# Run it (Windows):  antares examples/world.ant

W = 960
H = 540
window(W, H, "A Little World")

# Where things are: trees, houses and lamp posts, placed once.
seed(7)
trees = []
repeat 40 {
    a = rand() * 6.283
    d = 9 + rand() * 18
    trees = push(trees, {x: cos(a) * d, z: sin(a) * d, h: 1.6 + rand() * 1.4})
}
houses = [{x: -5, z: -4, turn: 20, colour: "#e8d8c0"}, {x: 4, z: -6, turn: -15, colour: "#d9a38a"}, {x: 6, z: 3, turn: 60, colour: "#c9d6e3"}]
posts = [[-2, -1], [2, 1], [0, -6], [-6, 3]]

# a roof: a long wedge, made once from its corners and triangles
roof = mesh([[-0.5, 0, -0.5], [0.5, 0, -0.5], [0.5, 0, 0.5], [-0.5, 0, 0.5], [0, 0.5, -0.5], [0, 0.5, 0.5]],
            [[0, 3, 5], [0, 5, 4], [1, 4, 5], [1, 5, 2], [0, 4, 1], [3, 2, 5], [0, 1, 2], [0, 2, 3]])

ball = {x: 0, z: 4, vx: 0, vz: 0, spin: 0}
night = no
t = 0

to house(h) {
    box(h.x, 1, h.z, 3, 2, 2.4, {colour: h.colour, turn: h.turn, shine: 0.1})
    draw(roof, h.x, 2, h.z, {colour: "#8c3b2e", turn: h.turn, scale: [3.4, 2.4, 2.8], shine: 0.3})
    box(h.x, 0.6, h.z, 0.7, 1.2, 2.45, {colour: "#5a3a22", turn: h.turn})
}

to tree(tr) {
    cylinder(tr.x, tr.h * 0.25, tr.z, 0.15, tr.h * 0.5, "#6b4a2b")
    cone(tr.x, tr.h * 0.75, tr.z, tr.h * 0.35, tr.h * 0.9, {colour: "#2f6b34", shine: 0.15})
}

while window_open() {
    dt = frame()
    t += dt
    when pressed("escape") { stop }
    when pressed("f") { fullscreen(not fullscreen()) }
    when pressed("n") { night = not night }

    # roll the ball: push it with the keys, and let it slow down
    push_x = 0
    push_z = 0
    when held("left") or held("a") { push_x -= 1 }
    when held("right") or held("d") { push_x += 1 }
    when held("up") or held("w") { push_z -= 1 }
    when held("down") or held("s") { push_z += 1 }
    ball.vx = (ball.vx + push_x * 18 * dt) * (1 - 1.5 * dt)
    ball.vz = (ball.vz + push_z * 18 * dt) * (1 - 1.5 * dt)
    ball.x = clip(ball.x + ball.vx * dt, -28, 28)
    ball.z = clip(ball.z + ball.vz * dt, -28, 28)
    ball.spin += sqrt(ball.vx * ball.vx + ball.vz * ball.vz) * dt * 115

    # the camera follows the ball from behind and above
    camera(ball.x, 5, ball.z + 9, ball.x, 0.6, ball.z - 2)

    when night {
        sky("#05081a", "#141c3a", "#05050a")
        sun(-0.4, 0.8, -0.6, "#7f8fd8", 0.15)
        fog("#141c3a", 12, 45)
        each p in posts {
            lamp(p[0], 2.3, p[1], "#ffb050", 1.5, 9)
        }
    } else {
        sky("#4f86d9", "#d8e6f3", "#5d6b4a")
        sun(0.5, 1, 0.3)
        fog("#d8e6f3", 25, 70)
    }

    plane(0, 0, 0, 160, 160, {colour: "#6f9a4f", shine: 0.05})
    # a pond: shiny, and a little see-through
    cylinder(-7, 0.01, 8, 3.5, 0.02, {colour: [40, 90, 140, 0.8], shine: 0.95})
    each h in houses { house(h) }
    each tr in trees { tree(tr) }
    each p in posts {
        cylinder(p[0], 1.1, p[1], 0.06, 2.2, {colour: "#333", metal: 1, shine: 0.6})
        bulb = 0
        when night { bulb = 2 }
        sphere(p[0], 2.3, p[1], 0.18, {colour: "#ffe0a0", glow: bulb})
    }
    # a spinning metal sculpture
    box(2, 1.2, -1.5, 0.8, 0.8, 0.8, {colour: "#c0c6d0", metal: 1, shine: 0.85, turn: [t * 40, t * 60, 0]})
    # the ball
    sphere(ball.x, 0.6, ball.z, 0.6, {colour: "#e04848", shine: 0.7, turn: [ball.spin, 0, 0]})
    render()

    # a label above the ball, in 2D, drawn over the 3D world
    at = to_screen(ball.x, 1.6, ball.z)
    font("Segoe UI", 18, "bold")
    when at != nothing {
        label("you", at[0] - measure("you").width / 2, at[1], "white")
    }
    font("Segoe UI", 15)
    label("Arrows: roll   N: night   F: fullscreen", 16, 14, [255, 255, 255, 0.85])
    when night { glow(1.2, 16) }
    vignette(0.35)
}
