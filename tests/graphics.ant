# Graphics: window, drawing, input and screenshots.
# On Windows this opens a small window for a moment. Elsewhere, window()
# explains that graphics windows are Windows-only for now.

to fails(action, part) {
    try {
        action()
    } else problem {
        check(find(problem, part) >= 0, "expected a problem about \"{part}\", got: {problem}")
        give yes
    }
    fail("expected a problem about \"{part}\"")
}

# Drawing needs a window first
fails(() => rect(0, 0, 5, 5), "open one first")

opened = yes
try {
    window(64, 40, "Graphics test", 2)
} else problem {
    opened = no
    check(find(problem, "Windows") >= 0, "unexpected problem: {problem}")
    show "graphics: no windows on this system yet, as expected"
}

when opened {
    check(window_open(), "the window should be open")
    fails(() => window(10, 10), "already open")

    heart = [".r.r.", "rrrrr", ".rrr.", "..r.."]
    repeat 3 as n {
        fill("navy")
        rect(2, 2, 10, 6, "orange")
        rect(-5, -5, 3, 3)                   # off the picture: nothing, no problem
        circle(30, 10, 6, "#3c3")
        line(0, 39, 63, 20, [255, 255, 0])
        line(-1000000, 5, 1000000, 5, "white")
        pixel(60, 2)
        label("Hi {n}", 2, 28, "pink")
        label("big", 30, 26, "white", 2)
        sprite(heart, 50, 30, {r: "red"})
        frame()
    }

    # nothing pressed in a test
    check(not held("left") and not pressed("space") and not held("click"), "no keys should be down")
    check(key() == nothing, "no key should be waiting")
    m = mouse()
    check(kind(m.x) == "number" and kind(m.y) == "number" and kind(m.left) == "yes/no" and kind(m.right) == "yes/no", "mouse() gives x, y, left and right")

    shot = program_folder() + "/graphics_test.png"
    check(screenshot(shot) == shot and exists(shot), "screenshot should save a file")
    delete(shot)

    # helpful problems
    fails(() => fill("redd"), "a colour I don't know")
    fails(() => rect(0, 0, 5, 5, "#12"), "needs a colour")
    fails(() => rect(0, 0, 5, 5, [1, 2]), "a list of 2 numbers")
    fails(() => rect(0, 0, 5), "takes x, y, a width and a height")
    fails(() => held("spacebar"), "doesn't know a key called")
    fails(() => sprite("x", 0, 0, {}), "list of text rows")
    fails(() => sprite(["ab"], 0, 0, {ab: "red"}), "one character each")
    fails(() => label("x", 0, 0, "white", 0), "size that is a whole number")
    fails(() => window(0, 10), "whole number from 1 to 8192")
    wait(0.05)
    check(window_open(), "the window should still be open")
    show "graphics: window, drawing, input and screenshots ok"
}

# ---------- pictures: these work on every system, with or without a window ----------

to near(got, want, what) {
    check(len(got) == len(want), "{what}: expected {want}, got {got}")
    each i in range(len(want)) {
        check(abs(got[i] - want[i]) <= 2, "{what}: expected {want}, got {got}")
    }
}

p = picture(40, 30)
check(p.width == 40 and p.height == 30, "picture(width, height) gives its size")
canvas(p)
check(colour_at(0, 0) == [0, 0, 0, 0], "a new picture is see-through")
check(colour_at(-1, 0) == nothing and colour_at(40, 0) == nothing, "outside the picture there is no colour")

# solid shapes at whole numbers cover whole pixels exactly
fill("navy")
near(colour_at(5, 5), [0, 0, 128], "fill")
rect(2, 2, 10, 6, "orange")
near(colour_at(2, 2), [255, 165, 0], "rect's corner")
near(colour_at(11, 7), [255, 165, 0], "rect's other corner")
near(colour_at(12, 7), [0, 0, 128], "just outside rect")

# smooth edges: half a pixel covered gives half the colour
fill("black")
rect(10.5, 0, 5, 5, "white")
near(colour_at(10, 2), [128, 128, 128], "half-covered pixel")
near(colour_at(11, 2), [255, 255, 255], "covered pixel")

# see-through colours mix with what is under them
fill("white")
rect(0, 0, 10, 10, [255, 0, 0, 0.5])
near(colour_at(5, 5), [255, 128, 128], "half-see-through red on white")
rect(0, 0, 10, 10, "#0000ff80")
near(colour_at(5, 5), [127, 64, 191], "a colour code with alpha")

# blend modes
fill([100, 100, 100])
blend("add")
rect(0, 0, 10, 10, [100, 50, 200])
blend()
near(colour_at(5, 5), [200, 150, 255], "add")
blend("multiply")
rect(0, 0, 10, 10, [255, 128, 0])
blend()
near(colour_at(5, 5), [200, 75, 0], "multiply")
fails(() => blend("lighter"), "blend knows")

# circles, rings, ellipses, polygons, paths and lines
fill("black")
circle(20, 15, 8, "lime")
near(colour_at(20, 15), [0, 255, 0], "circle's middle")
near(colour_at(20, 3), [0, 0, 0], "outside the circle")
ring(20, 15, 10, 2, "red")
near(colour_at(29, 15), [255, 0, 0], "ring")
near(colour_at(25, 15), [0, 255, 0], "inside the ring")
fill("black")
ellipse(20, 15, 15, 4, "white")
near(colour_at(33, 15), [255, 255, 255], "ellipse is wide")
near(colour_at(20, 10), [0, 0, 0], "ellipse is short")
fill("black")
polygon([[0, 0], [20, 0], [0, 20]], "yellow")
near(colour_at(3, 3), [255, 255, 0], "inside the triangle")
near(colour_at(15, 15), [0, 0, 0], "outside the triangle")
fill("black")
line(0, 10, 39, 10, "white")
near(colour_at(20, 10), [255, 255, 255], "a line at whole numbers is sharp")
near(colour_at(20, 9), [0, 0, 0], "and one pixel thick")
line(0, 20, 39, 20, "white", 5)
near(colour_at(20, 22), [255, 255, 255], "a thick line")
path([[2, 2], [30, 2], [30, 25], [2, 2]], "cyan", 2)
near(colour_at(16, 2), [0, 255, 255], "a path")
fails(() => polygon([1, 2, 3]), "list of points")

# gradients and colours made from numbers
fill(gradient(0, 0, 40, 0, ["black", "white"]))
near(colour_at(0, 5), [3, 3, 3], "gradient's start")
near(colour_at(39, 5), [252, 252, 252], "gradient's end")
near(colour_at(20, 5), [131, 131, 131], "gradient's middle")
fill(radial(20, 15, 10, ["red", "blue"]))
near(colour_at(20, 15), [237, 0, 18], "radial's centre")
near(colour_at(0, 0), [0, 0, 255], "radial's outside")
fill(radial(20, 15, 10, [[255, 0, 0, 1], [0, 0, 255, 1]]))
near(colour_at(20, 15), [237, 0, 18], "gradient colours given as numbers")
check(hsl(0, 1, 0.5) == [255, 0, 0] and hsl(120, 1, 0.5) == [0, 255, 0], "hsl")
check(hsl(240, 1, 0.5, 0.5) == [0, 0, 255, 0.5], "hsl with alpha")
check(mix("black", "white", 0.5) == [128, 128, 128], "mix")
fails(() => rect(0, 0, 5, 5, [255, 0, 0, 7]), "goes from 0 (see-through) to 1")

# smooth(no): hard pixel edges
fill("black")
smooth(no)
rect(10.5, 0, 5, 5, "white")
near(colour_at(10, 2), [255, 255, 255], "hard edges round down")
smooth(yes)

# pictures drawn on pictures: placed, scaled, turned, faded, flipped and in parts
dot = picture(4, 2)
canvas(dot)
rect(0, 0, 2, 2, "red")
rect(2, 0, 2, 2, "blue")
canvas(p)
fill("black")
draw(dot, 10, 10)
near(colour_at(10, 10), [255, 0, 0], "draw")
near(colour_at(13, 11), [0, 0, 255], "draw, the other side")
fill("black")
draw(dot, 0, 0, {scale: 3, smooth: no})
near(colour_at(5, 5), [255, 0, 0], "scaled")
near(colour_at(6, 5), [0, 0, 255], "scaled, the other half")
fill("black")
draw(dot, 0, 0, {flip: yes})
near(colour_at(0, 0), [0, 0, 255], "flipped")
fill("black")
draw(dot, 0, 0, {part: [2, 0, 2, 2], scale: 2})
near(colour_at(1, 1), [0, 0, 255], "a part")
fill("black")
draw(dot, 10, 10, {alpha: 0.5})
near(colour_at(10, 10), [128, 0, 0], "faded")
fill("black")
draw(dot, 10, 10, {angle: 180})
near(colour_at(10, 10), [0, 0, 255], "turned half way round")
fill("white")
draw(dot, 10, 10, {tint: "lime"})
near(colour_at(10, 10), [0, 0, 0], "tinted")
fails(() => draw(dot, 0, 0, {spin: 4}), "doesn't know the option")
fails(() => draw({x: 1}, 0, 0), "needs a picture")

# shadows, blur, glow and vignette
fill("white")
shadow(3, 3, 0, "black")
rect(5, 5, 10, 10, "red")
shadow()
near(colour_at(16, 16), [0, 0, 0], "a hard shadow")
near(colour_at(6, 6), [255, 0, 0], "the shape over its shadow")
fill("black")
rect(0, 0, 20, 30, "white")
blur(4)
c = colour_at(20, 15)
check(c[0] > 30 and c[0] < 225, "blur softens an edge: {c}")
fill("black")
rect(18, 13, 4, 4, "white")
glow(2, 8, 0.5)
check(colour_at(24, 15)[0] > 0, "glow spreads light")
fill("white")
vignette(1)
check(colour_at(0, 0)[0] < 128 and colour_at(20, 15)[0] == 255, "vignette darkens the corners only")

# text: the pixel font, and measuring
fill("black")
label("I", 0, 0, "white")
near(colour_at(2, 3), [255, 255, 255], "pixel font")
m = measure("Hi")
check(m.width == 12 and m.height == 8, "measure in the pixel font: {m}")
check(measure("Hi", 2).width == 24, "measure at size 2")
font("Arial", 20)
m = measure("Hello")
check(m.width > 20 and m.height >= 10, "measure in a font: {m}")
label("Hello", 0, 0, "white")
font()
fails(() => font("Arial", 20, "wobbly"), "styles")

# PNG files: saved and read back, with see-through parts
fill("transparent")
rect(0, 0, 20, 30, [255, 0, 0, 0.5])
file = program_folder() + "/graphics_picture.png"
screenshot(file)
back = picture(file)
check(back.width == 40 and back.height == 30, "a saved picture reads back at its size")
canvas(back)
near(colour_at(5, 5), [255, 0, 0, 0.5], "see-through parts survive saving")
check(colour_at(30, 5) == [0, 0, 0, 0], "empty parts stay empty")
check(picture(file).picture == back.picture, "a file is read once")
delete(file)
fails(() => picture("no such file.png"), "couldn't read the picture")
canvas()
show "graphics: pictures, shapes, colours, text and effects ok"

# ---------- 3D: models and placing work everywhere; drawing needs Windows ----------

m = mesh([[0, 0, 0], [1, 0, 0], [0, 1, 0]], [[0, 1, 2]])
check(m.triangles == 1, "a mesh of one triangle: {m}")
check(m.size == [1, 1, 0], "a mesh's size: {m.size}")
fails(() => mesh([[0, 0, 0]], [[0, 1, 2]]), "corners by number")
fails(() => cube(0, 0, 0, 1, {wobble: 1}), "doesn't know the option")
fails(() => cube(0, 0, 0, -1), "size of 0 or more")
fails(() => draw({mesh: 99999}, 0, 0, 0), "needs a model")
objfile = program_folder() + "/graphics_model.obj"
write(objfile, "v 0 0 0\nv 1 0 0\nv 1 1 0\nv 0 1 0\nf 1 2 3 4\n")
quad = mesh(objfile)
check(quad.triangles == 2, "an .obj face with four corners is two triangles")
check(mesh(objfile).mesh == quad.mesh, "a model file is read once")
delete(objfile)
fails(() => mesh("no such model.obj"), "couldn't read the model")

p3 = picture(64, 48)
canvas(p3)
camera(0, 2, 6, 0, 0.5, 0)
mid = to_screen(0, 0.5, 0)
check(abs(mid[0] - 32) < 0.01 and abs(mid[1] - 24) < 0.01, "what the camera looks at is in the middle: {mid}")
check(to_screen(0, 0, 50) == nothing, "a point behind the camera isn't on the picture")

sky("skyblue", "white", "gray")
sun(0.3, 1, 0.5)
plane(0, 0, 0, 20, 20, "green")
cube(0, 0.5, 0, 1, "red")
drawn = yes
try {
    render()
} else problem {
    drawn = no
    check(find(problem, "Windows") >= 0, "unexpected problem: {problem}")
    show "graphics: 3D drawing is Windows-only here, as expected"
}
when drawn {
    c = colour_at(32, 1)
    check(c[2] > c[0], "the sky is blue at the top: {c}")
    c = colour_at(32, 24)
    check(c[0] > 120 and c[1] < 90, "the red cube is in the middle: {c}")
    c = colour_at(6, 44)
    check(c[1] > c[0] and c[1] > c[2], "the ground is green: {c}")
    # without a sky, 3D goes over what is already there
    fill("blue")
    sky()
    sphere(0, 0.5, 0, 0.5, {colour: "white", shine: 0.9, metal: 1})
    render()
    check(colour_at(1, 1) == [0, 0, 255], "3D without a sky leaves the background")
    check(colour_at(32, 24) != [0, 0, 255], "and draws the sphere over it")
    # lamps, fog, see-through shapes and pictures on shapes
    fill("black")
    sky("black")
    sun()
    fog("black", 3, 30)
    lamp(0, 2, 1, "white", 2)
    plane(0, 0, 0, 20, 20, {picture: dot, tiles: 4})
    cube(0, 0.5, 0, 1, [255, 255, 255, 0.5])
    render()
    check(colour_at(32, 30)[0] > 0, "a lamp lights the ground")
    fog()
    sun(0.5, 1, 0.3)
    show "graphics: 3D ok"
}
canvas()
