# Graphics: window, drawing, input and screenshots.
# On Windows this opens a small window for a moment. Elsewhere, window()
# explains that graphics windows are Windows-only for now.

to fails(action, part) {
    try {
        action()
    } else problem {
        check(find(problem, part) >= 0, "expected a problem about \"{part}\", got: {problem}")
        give yes
    }
    fail("expected a problem about \"{part}\"")
}

# Drawing needs a window first
fails(() => rect(0, 0, 5, 5), "open one first")

opened = yes
try {
    window(64, 40, "Graphics test", 2)
} else problem {
    opened = no
    check(find(problem, "Windows") >= 0, "unexpected problem: {problem}")
    show "graphics: no windows on this system yet, as expected"
}

when opened {
    check(window_open(), "the window should be open")
    fails(() => window(10, 10), "already open")

    heart = [".r.r.", "rrrrr", ".rrr.", "..r.."]
    repeat 3 as n {
        fill("navy")
        rect(2, 2, 10, 6, "orange")
        rect(-5, -5, 3, 3)                   # off the picture: nothing, no problem
        circle(30, 10, 6, "#3c3")
        line(0, 39, 63, 20, [255, 255, 0])
        line(-1000000, 5, 1000000, 5, "white")
        pixel(60, 2)
        label("Hi {n}", 2, 28, "pink")
        label("big", 30, 26, "white", 2)
        sprite(heart, 50, 30, {r: "red"})
        frame()
    }

    # nothing pressed in a test
    check(not held("left") and not pressed("space") and not held("click"), "no keys should be down")
    check(key() == nothing, "no key should be waiting")
    m = mouse()
    check(kind(m.x) == "number" and kind(m.y) == "number" and kind(m.left) == "yes/no" and kind(m.right) == "yes/no", "mouse() gives x, y, left and right")

    shot = program_folder() + "/graphics_test.png"
    check(screenshot(shot) == shot and exists(shot), "screenshot should save a file")
    delete(shot)

    # helpful problems
    fails(() => fill("redd"), "a colour I don't know")
    fails(() => rect(0, 0, 5, 5, "#12"), "needs a colour")
    fails(() => rect(0, 0, 5, 5, [1, 2]), "a list of 2 numbers")
    fails(() => rect(0, 0, 5), "takes x, y, a width and a height")
    fails(() => held("spacebar"), "doesn't know a key called")
    fails(() => sprite("x", 0, 0, {}), "list of text rows")
    fails(() => sprite(["ab"], 0, 0, {ab: "red"}), "one character each")
    fails(() => label("x", 0, 0, "white", 0), "size that is a whole number")
    fails(() => window(0, 10), "whole number from 1 to 4096")
    wait(0.05)
    check(window_open(), "the window should still be open")
    show "graphics: window, drawing, input and screenshots ok"
}
