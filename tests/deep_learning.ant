# Deep learning: activations, losses, building blocks, optimisers and data.

to near(a, b) = sum(abs(a - b)) < 0.000001

to fails(action, part) {
    try {
        action()
    } else problem {
        check(find(problem, part) >= 0, "expected a problem about \"{part}\", got: {problem}")
        give yes
    }
    fail("expected a problem about \"{part}\"")
}

# Activations
check(near(gelu(0), 0) and near(silu(0), 0) and near(softplus(0), log(2)), "activations at 0")
check(near(leaky_relu(-1), -0.01) and leaky_relu(2) == 2, "leaky_relu")
check(gelu(3) > 2.99 and gelu(-3) > -0.01, "gelu is close to relu far from 0")

# log_softmax and cross_entropy
ls = log_softmax([1, 2, 3])
check(near(sum(exp(ls)), 1), "log_softmax gives log-probabilities")
check(near(cross_entropy([[0, 0, 0, 0]], [2]), log(4)), "even scores over 4 classes: loss ln 4")
check(near(cross_entropy([[0, 0, 0, 0]], [[0, 0, 1, 0]]), log(4)), "answers as probabilities")
check(cross_entropy([[10, 0], [0, 10]], [0, 1]) < 0.001, "confident and right: small loss")
fails(() => cross_entropy([[1, 2]], [5]), "isn't a class number")

# mse and bce
check(near(mse([1, 2, 3], [1, 2, 5]), 4 / 3), "mse")
check(near(bce([0.5, 0.5], [1, 0]), log(2)), "bce at 0.5")

# take: rows by position (an embedding lookup)
table = [[1, 2], [3, 4], [5, 6]]
check(take(table, [2, 0]) == [[5, 6], [1, 2]], "take rows")
check(take(table, 1) == [3, 4], "take one row")
check(take([10, 20, 30], [-1]) == [30], "take counts from the end")
fails(() => take(table, [3]), "out of range")

# concat
check(shape(concat([[[1], [2]], [[3, 4], [5, 6]]], 1)) == [2, 3], "concat along columns")
check(concat([[1, 2], [3]]) == [1, 2, 3], "concat rows of numbers")

# layer_norm, dropout, causal_mask, starting weights
n = layer_norm([[1, 2, 3], [10, 20, 30]])
check(near(sum(n[0]), 0) and sum(abs(n[0] - n[1])) < 0.001 and abs(n[0, 2] - 1.2247) < 0.001, "layer_norm centres and scales each row")
check(dropout([1, 2, 3], 0) == [1, 2, 3], "no dropout at 0")
seed(3)
d = dropout(ones(1000), 0.5)
check(abs(mean(d) - 1) < 0.15, "dropout keeps the average")
m = causal_mask(3)
check(m[0, 0] == 0 and m[0, 2] < -1000 and m[2, 0] == 0, "causal mask hides later positions")
check(shape(xavier(4, 3)) == [4, 3] and shape(he(5, 2)) == [5, 2], "starting weights")

# accuracy, top, sample
check(accuracy([[0.9, 0.1], [0.2, 0.8], [0.6, 0.4]], [0, 1, 1]) == 2 / 3, "accuracy")
check(top([5, 9, 1, 7], 2) == [1, 3], "top positions")
seed(1)
counts = zeros(3)
repeat 300 {
    k = sample([0.2, 0.5, 0.3])
    counts[k] += 1
}
check(counts[1] > counts[0] and counts[1] > counts[2], "sample follows the probabilities")
check(sample([0, 1, 0]) == 1, "certain choice")
check(sample([0.4, 0.6], 0.01) == 1, "low temperature picks the likeliest")

# Every optimiser, with clipping, learns a small classifier
seed(7)
x = [[0, 0], [0, 1], [1, 0], [1, 1]]
answers = [0, 1, 1, 0]
each method in ["sgd", "momentum", "adam", "adamw"] {
    seed(7)
    learn w1 = he(2, 16)
    learn b1 = zeros(16)
    learn w2 = xavier(16, 2)
    learn b2 = zeros(2)
    repeat 400 {
        scores = gelu(x @ w1 + b1) @ w2 + b2
        loss = cross_entropy(scores, answers)
        when method == "sgd" { descend loss by 0.3 clip 5 }
        else when method == "momentum" { descend loss by 0.05 using momentum clip 5 }
        else when method == "adam" { descend loss by 0.03 using adam clip 5 }
        else { descend loss by 0.03 using adamw clip 5 }
    }
    check(accuracy(scores, answers) == 1, "{method} learned XOR (loss {loss})")
}

# take passes gradients to the rows it picked
learn emb = zeros(3, 2)
descend sum(take(emb, [1, 1])) by 0.5
check(emb[0] == [0, 0] and emb[1] == [-1, -1], "only picked rows change, once per pick")

# Data: CSV, columns, shuffle, batches
file = program_folder() + "/deep_learning_test.csv"
write(file, "size,price,city\n1.5,300,\"Kandy, LK\"\n2,410,Colombo\n0.8,150,\n")
rows = read_csv(file)
delete(file)
check(len(rows) == 3 and rows[0].city == "Kandy, LK" and rows[2].city == nothing, "read_csv")
check(columns(rows, ["size", "price"]) == [[1.5, 300], [2, 410], [0.8, 150]], "columns as a table")
check(columns(rows, "price") == [300, 410, 150], "one column")
fails(() => columns(rows, "city"), "not a number")
seed(5)
s = shuffle(range(10))
check(sort(s) == range(10) and s != range(10), "shuffle keeps every item")
check(len(shuffle(["a", "b", "c"])) == 3, "shuffle lists")
b = batches(range(10), 4)
check(len(b) == 3 and b[2] == [8, 9], "batches")
check(shape(batches(zeros(5, 2), 2)[0]) == [2, 2], "batches of rows")

show "deep learning: activations, losses, layers, optimisers and data ok"
